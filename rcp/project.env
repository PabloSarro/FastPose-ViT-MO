# RCP settings for this project. Change the values here; the other files in rcp/ don't need editing.

# Image (installed software), from registry.rcp.epfl.ch, with its version tag after ":".
# The default is the lab image (CUDA, Python, uv, JupyterLab). Change it if your
# supervisor gives you another one, or if you build your own.
IMAGE=registry.rcp.epfl.ch/cvlab-pablo/fastposevit:1.60 # 1.59 + libegl1; previous: fastposevit:1.59, cvlab-pancey/base:0.4

# Folders. By default:
#   DATA_DIR    $NAS_HOME/datasets                 input data, shared by your projects
#   OUTPUT_DIR  $NAS_HOME/outputs/<project name>   results, one folder per project
# To use other folders, remove the "#" and change the path:
DATA_DIR=/mnt/cvlab/scratch/cvlab/home/pvancey/datasets # or my own /sarro direct access?
# OUTPUT_DIR=$NAS_HOME/outputs/MY_PROJECT

# Name of this project's interactive job (started by `dev`). Give each project its
# own name so the dev jobs of two projects don't collide, e.g. DEV_JOB=myproject-dev.
DEV_JOB=fastpose-dev

# Default job size. For one job only, put it in front: GPUS=2 train NAME COMMAND
GPUS=${GPUS:-1}
CPUS=${CPUS:-16}
MEMORY=${MEMORY:-32Gi}
NODE_POOL=${NODE_POOL:-default}   # group of machines to run on; keep default unless told otherwise
